        "type": "function",
        "z": "flow_scada_pro_01",
        "name": "Guardar modo",
        "func": "flow.set('modo', msg.payload);\nlet t = 0;\nif (msg.payload === 'manual') {\n    t = Number(flow.get('temp_manual') || 0);\n} else {\n    t = Number(flow.get('temp_python') || 0);\n}\nreturn { payload: t };",
