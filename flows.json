    {
        "id": "fn_select_source_01",
        "type": "function",
        "z": "flow_scada_pro_01",
        "name": "Seleccionar fuente",
        "func": "let modo = flow.get('modo') || 'python';\nlet t = 0;\nif (modo === 'manual') {\n    t = Number(flow.get('temp_manual') || 0);\n} else {\n    t = Number(flow.get('temp_python') || 0);\n}\nflow.set('temp_activa', t);\nmsg.payload = t;\nmsg.topic = 'temperatura';\nreturn msg;",
