        "type": "function",
        "z": "flow_scada_pro_01",
        "name": "Alarma de temperatura",
        "func": "let t = Number(msg.payload || 0);\nlet txt = 'NORMAL';\nif (t > 35) txt = 'ALARMA ALTA TEMPERATURA';\nelse if (t >= 27) txt = 'VENTILACION ACTIVA';\nelse if (t < 10) txt = 'TEMPERATURA MUY BAJA';\nmsg.payload = txt;\nreturn msg;",
