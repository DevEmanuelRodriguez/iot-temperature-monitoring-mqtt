    {
        "id": "ui_template_fan_01",
        "type": "ui_template",
        "z": "flow_scada_pro_01",
        "group": "ui_group_scada_01",
        "name": "Fan SCADA",
        "order": 10,
        "width": 6,
        "height": 5,
        "format": "<style>\n.card-scada{background:#111827;color:#e5e7eb;border-radius:12px;padding:16px;border:2px solid #374151;box-shadow:0 0 10px rgba(0,0,0,0.35);font-family:Arial,Helvetica,sans-serif;}\n.card-title{font-size:20px;font-weight:bold;margin-bottom:12px;color:#22d3ee;text-align:center;}\n.fan-wrap{display:flex;justify-content:center;align-items:center;height:180px;}\n.fan{\n  width:110px;\n  height:110px;\n  border:6px solid #6b7280;\n  border-radius:50%;\n  position:relative;\n  background:#1f2937;\n}\n.fan.spin{animation:spin 1s linear infinite;border-color:#22c55e;box-shadow:0 0 20px rgba(34,197,94,0.6);}\n.blade{\n  position:absolute;\n  width:24px;\n  height:44px;\n  background:#9ca3af;\n  left:50%;\n  top:50%;\n  margin-left:-12px;\n  margin-top:-44px;\n  border-radius:12px 12px 6px 6px;\n  transform-origin:12px 44px;\n}\n.b1{transform:rotate(0deg);} \n.b2{transform:rotate(120deg);} \n.b3{transform:rotate(240deg);} \n.core{\n  position:absolute;\n  width:24px;\n  height:24px;\n  background:#f3f4f6;\n  border-radius:50%;\n  left:50%;\n  top:50%;\n  margin-left:-12px;\n  margin-top:-12px;\n  z-index:5;\n}\n.status-on{color:#22c55e;font-weight:bold;text-align:center;font-size:18px;}\n.status-off{color:#ef4444;font-weight:bold;text-align:center;font-size:18px;}\n@keyframes spin{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}\n</style>\n\n<div class=\"card-scada\">\n  <div class=\"card-title\">VENTILADOR SCADA</div>\n  <div class=\"fan-wrap\">\n    <div class=\"fan\" ng-class=\"{'spin': msg.payload == 1}\">\n      <div class=\"blade b1\"></div>\n      <div class=\"blade b2\"></div>\n      <div class=\"blade b3\"></div>\n      <div class=\"core\"></div>\n    </div>\n  </div>\n  <div ng-class=\"msg.payload == 1 ? 'status-on' : 'status-off'\">\n    {{msg.payload == 1 ? 'ENCENDIDO' : 'APAGADO'}}\n  </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 620,
        "y": 500,
        "wires": [
