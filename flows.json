    {
        "id": "fn_histeresis_01",
        "type": "function",
        "z": "flow_scada_pro_01",
        "name": "Control 27 ON / 23 OFF",
        "func": "let t = Number(msg.payload || 0);\nlet estado = Number(flow.get('cmd_motor') || 0);\n\nif (t >= 27) estado = 1;\nif (t <= 23) estado = 0;\n\nflow.set('cmd_motor', estado);\nmsg.payload = estado;\nmsg.topic = 'sensores/ventilador';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 860,
        "y": 120,
        "wires": [
            [
                "mqtt_cmd_out_01"
            ]
        ]
